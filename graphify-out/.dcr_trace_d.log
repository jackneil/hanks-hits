188: const searchInput = document.getElementById('search');
189: const searchResults = document.getElementById('search-results');
190: searchInput.addEventListener('input', () => {
191:   const q = searchInput.value.toLowerCase().trim();
192:   searchResults.innerHTML = '';
193:   if (!q) { searchResults.style.display = 'none'; return; }
194:   const matches = RAW_NODES.filter(n => n.label.toLowerCase().includes(q)).slice(0, 20);
195:   if (!matches.length) { searchResults.style.display = 'none'; return; }
196:   searchResults.style.display = 'block';
197:   matches.forEach(n => {
198:     const el = document.createElement('div');
199:     el.className = 'search-item';
200:     el.textContent = n.label;
201:     el.style.borderLeft = `3px solid ${n.color.background}`;
202:     el.style.paddingLeft = '8px';
203:     el.onclick = () => {
204:       network.focus(n.id, { scale: 1.5, animation: true });
205:       network.selectNodes([n.id]);
206:       showInfo(n.id);
207:       searchResults.style.display = 'none';
208:       searchInput.value = '';
209:     };
210:     searchResults.appendChild(el);
