145: function focusNode(nodeId) {
146:   network.focus(nodeId, { scale: 1.4, animation: true });
147:   network.selectNodes([nodeId]);
148:   showInfo(nodeId);
149: }
150: 
151: // Neighbor links use a data attribute + one delegated listener rather than an
152: // inline onclick. A node id/label sourced from a document or a scraped URL
153: // (graphify add) can contain a double-quote; dropping the stringified id
154: // unescaped into a quoted onclick both broke every link and allowed a hostile
155: // source to inject an event handler into the local report (stored XSS, #1838).
156: // esc() on data-nid keeps the value inside the attribute; the listener reads it
157: // back verbatim. Bound to document so it survives the innerHTML rebuild that
158: // recreates #neighbors-list on each showInfo().
159: document.addEventListener('click', e => {
160:   const el = e.target.closest('.neighbor-link');
161:   if (el && el.dataset.nid !== undefined) focusNode(el.dataset.nid);
162: });
163: 
164: // Track hovered node — hover detection is more reliable than click params
165: let hoveredNodeId = null;
166: network.on('hoverNode', params => {
167:   hoveredNodeId = params.node;
168:   container.style.cursor = 'pointer';
169: });
170: network.on('blurNode', () => {
171:   hoveredNodeId = null;
172:   container.style.cursor = 'default';
173: });
174: container.addEventListener('click', () => {
175:   if (hoveredNodeId !== null) {
176:     showInfo(hoveredNodeId);
177:     network.selectNodes([hoveredNodeId]);
178:   }
179: });
180: network.on('click', params => {
181:   if (params.nodes.length > 0) {
182:     showInfo(params.nodes[0]);
183:   } else if (hoveredNodeId === null) {
184:     document.getElementById('info-content').innerHTML = '<span class="empty">Click a node to inspect it</span>';
185:   }
186: });
